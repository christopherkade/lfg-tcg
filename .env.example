# Copy to .env.local and fill in with your Supabase project's credentials
# (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Note: Discord OAuth credentials are NOT configured here. They're set per
# Supabase project under Authentication -> Providers -> Discord in the
# Supabase dashboard, not read from app env vars.

# To test locally against staging or prod without editing .env.local, create
# .env.staging.local / .env.production.local with the same two vars filled in
# for that project, then run `yarn dev:staging` / `yarn dev:prod`.
